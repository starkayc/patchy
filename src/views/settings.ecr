<%
  title = I18n.translate(locale, "index_settings")
%>

<% content_for "head" do %>
<title> <%= host %> - <%= title %></title>
<% end %>

<div class="container">
  <a href='/'><%= I18n.translate(locale, "go_back") %></a>
  <hr>
  <h2><%= title %></h2>
  <form class="" action="/-/settings/update_settings" method="post">
      <fieldset>
          <div class="user-settings-fields">
              <div class="">
                <label for="filename_length" class="label"><%= I18n.translate(locale, "user_settings_filename_length") %></label>
                <input name="filename_length" id="filename_length" type="number" min="<%= CONFIG.min_filename_length %>" max="<%= CONFIG.max_filename_length %>" value="<%= user_settings.filename_length %>">
                <div class="user-settings-description-box">
                    <div class="user-settings-description-elements">
                        <span class="">
                            <%= I18n.translate(locale, "user_settings_filename_length_min") %>: <%= CONFIG.min_filename_length %>
                        </span>
                        <span class="">
                            <%= I18n.translate(locale, "user_settings_filename_length_max") %>: <%= CONFIG.max_filename_length %>
                        </span>
                    </div>
                </div>
              </div>
          </div>

          <br>

          <div class="">
              <button type="submit" class="select-box"><%= I18n.translate(locale, "user_settings_save_settings") %></button>
          </div>
      </fieldset>
  </form>
</div>
